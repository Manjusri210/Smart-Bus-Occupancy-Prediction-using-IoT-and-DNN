# SmartBus AI Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=127.0.0.1

# Database Configuration
DATABASE_URL=sqlite:///smartbus.db

# Bus System Parameters
BUS_CAPACITY=40
POLLING_INTERVAL_SECONDS=5

# ML Configuration
MODEL_DIR=ml/models
ENABLE_MODEL_TRAINING_ENDPOINT=true

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ESP32 Serial Ingestion Bridge (Optional Live Device Mode)
SERIAL_PORT=COM3
SERIAL_BAUD_RATE=115200
BACKEND_INGEST_URL=http://127.0.0.1:5000/api/occupancy/ingest
